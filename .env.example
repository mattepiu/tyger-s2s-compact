# Copy to .env in the repo root (gitignored) and fill in. Never commit real keys.
# Hugging Face token for the PRIVATE turn-taking heads release (nineninesix/TYGER-S2S-endpointer). If a token file
# already exists at $HF_HOME/token, run.sh uses that and you can leave this blank.
HF_TOKEN=
# Hosted LLM plugins, only if config/default.yaml names one: the block's `api_key_env` says which variable it reads
# (openai-responses: OPENAI_API_KEY, the `smart` default; anthropic: ANTHROPIC_API_KEY). They send transcripts to
# that provider; keep the SDK debug logs (OPENAI_LOG, ANTHROPIC_LOG) unset, they print request bodies.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# API mode only (README -> "API mode"): the secret your app's backend signs conversation tokens with (HS256). Unset:
# no token check, so anyone can connect. Env only, never in config/default.yaml; never logged. The other API-mode
# settings (TYGER_PAGES, TYGER_MAX_SESSION_S) can go here too, or in config/default.yaml's server: block.
TYGER_API_SECRET=
# Optional (README -> "RunPod + Cloudflare"): a Cloudflare Tunnel's token. Set, run.sh starts cloudflared once EARS
# is up, and Cloudflare serves the tunnel's hostname over HTTPS / wss. Whoever holds it can serve that hostname.
CLOUDFLARE_TUNNEL_TOKEN=
