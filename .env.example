# Copy to v1/.env (gitignored) and fill in. Never commit real keys.
# HuggingFace token for the PRIVATE endpoint-head repo (nineninesix/tyger-exp10-heads). If a token file
# already exists at $HF_HOME/token, run.sh uses that and you can leave this blank.
HF_TOKEN=
# Hosted plugins (PLUGINS.md), only if config.yaml names one: the block's `api_key_env` says which variable it reads.
# They send transcripts to that provider; keep the SDK debug logs (OPENAI_LOG,
# ANTHROPIC_LOG) unset, they print request bodies.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
