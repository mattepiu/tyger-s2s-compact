# Copy to v1/.env (gitignored) and fill in. Never commit real keys.
# Tavily powers web_search + get_weather; without it those tools return an error and the model says so.
TAVILY_API_KEY=
# HuggingFace token for the PRIVATE endpoint-head repo (nineninesix/tyger-exp10-heads). If a token file
# already exists at $HF_HOME/token, run.sh uses that and you can leave this blank.
HF_TOKEN=
