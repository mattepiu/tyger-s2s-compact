# Secrets — never commit
.env
.env.*
!.env.example

# Voice reference clips, their transcripts, and any audio (personal data)
voices/
*.wav
*.flac
*.mp3
*.ogg

# Python / local env
__pycache__/
*.pyc
venv*/
.venv/

# Benchmark logs (scripts/bench_stack.sh)
bench_runs/

# The page check's npm install (tests/page)
node_modules/
tests/page/package-lock.json

# The GPU agent's memory snapshot: the user pastes it in by hand, never committed
agent-memory/

# The user's own memos (e.g. the 2nd ear): kept on the Mac, never committed
memos/

# The current round's handoff (for the GPU agent or a teammate): the user passes it by hand, never committed
/HANDOFF.md
